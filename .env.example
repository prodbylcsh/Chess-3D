# Online play needs a Supabase project (see README "Online multiplayer").
# Copy to .env.local for local development. Both values are public: the anon /
# publishable key only grants what the row-level security policies allow.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
